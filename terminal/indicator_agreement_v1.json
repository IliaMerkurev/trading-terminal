  "raw_contract": {
    "time": "UTC integer seconds at candle open",
    "display_time": "UTC integer seconds at confirmation close",
    "confirmed": [
      "closed_rest",
      "provider_confirmed",
      "synthetic_closed"
    ],
    "target": "exact_requested_close_only",
    "predecessors": "real_contiguous_confirmed_raw_bars",
    "values": "existing_display_outputs_only",
    "envelope_validation": "caller_must_validate_source_revision_origin_window_generation_and_freshness",
    "validity": "finite open/high/low/close; low <= open and close <= high; no explicit conflict"
  },
  "guards": {
    "flat_closes": {
      "length": "period + 1",
      "test": "all closes equal",
      "result": "neutral"
    },
    "flat_range": {
      "length": "period",
      "test": "maximum high equals minimum low",
      "result": "neutral"
    },
    "flat_smoothed_range": {
      "length": "period + smooth - 1",
      "test": "maximum high equals minimum low over all smoothing inputs",
      "result": "neutral"
    },
    "adjacent_confirmed": {
      "length": 2,
      "test": "adjacent raw closes and finite adjacent output",
      "result": "sign of current minus previous"
    },
    "insufficient": "unavailable",
    "undefined_output": "unavailable_even_when_flat"
  },
  "weighting": {
    "duplicate_identity": "type + sorted parameters with IEEE754 numeric normalization",
    "duplicate_conflict": "unavailable unless all visible copies have identical assessment evidence",
    "variants": "equal available variants within type",
    "types": "equal available types within group",
    "groups": "equal available groups overall",
    "neutral": "included in every denominator",
    "excluded": [
      "hidden",
      "context",
      "unsupported",
      "unavailable"
    ],
    "fully_covered_type": "all distinct supported visible variants available"
  },
  "coverage": {
    "minimum_available_groups": 2,
    "minimum_fully_covered_type_fraction": [
      1,
      2
    ]
  },
  "rounding": {
    "method": "largest_remainder",
    "total": 100,
    "tie_order": [
      "up",
      "down",
      "neutral"
    ]
  },
  "threshold": {
    "overall": "inclusive exact fraction >= shortest decimal representation of numeric threshold",
    "required_groups": "each exact directional fraction strictly > 1/2",
    "missing": "unavailable",
    "range": [
      0,
      1
    ]
  },
  "wording": "Descriptive heuristic; not probability, confidence, price strength or a trading recommendation"
}
